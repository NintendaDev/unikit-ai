{
  "key": "unity-biome-mcp",
  "code": "unity-biome-mcp",
  "is_engine": true,
  "order": 1,
  "displayName": "Unity Biome MCP (Unity 6000.0+)",
  "docs": {
    "context7": "/german-krasnikov/unity-biome-mcp",
    "repo": "https://github.com/german-krasnikov/unity-biome-mcp",
    "sources": [
      { "kind": "git", "id": "client-skills", "repo": "https://github.com/german-krasnikov/unity-biome-mcp", "ref": "master", "path": "unity-plugin/ClientSkills", "include": ["**/*.md"], "into": "client-skills" },
      { "kind": "git", "id": "docs", "repo": "https://github.com/german-krasnikov/unity-biome-mcp", "ref": "master", "path": "docs", "include": ["**/*.md"], "exclude": ["i18n/**"], "into": "docs" }
    ]
  },
  "rules": "rules/unity-biome-mcp/",
  "config": {
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/german-krasnikov/unity-biome-mcp.git@v{{ VERSION }}#subdirectory=server",
      "unity-biome-mcp"
    ],
    "env": {
      "UNITY_MCP_NO_GATING": "1"
    }
  },
  "allowed-tools": {
    "agents": {
      "unikit-implement-coordinator": [
        "*"
      ],
      "unikit-implement-worker": [
        "*"
      ],
      "unikit-review-sidecar": [
        "*"
      ]
    },
    "skills": {
      "unikit-plan": [
        "discover_tools",
        "mcp_status"
      ],
      "unikit-devcontext": [
        "*"
      ],
      "unikit-implement": [
        "*"
      ],
      "unikit-fix": [
        "*"
      ],
      "unikit-verify": [
        "*"
      ],
      "unikit-bridge-audit": [
        "*"
      ]
    }
  }
}
